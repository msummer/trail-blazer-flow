# trail-blazer-flow — Codex rules (#408)
#
# Generated by bin/codex-setup.sh and installed to .codex/rules/trail-blazer-flow.rules in the
# target repo. Do NOT edit the installed copy by hand — re-run codex-setup.sh instead, which
# regenerates it from this template. Re-run it again after every plugin upgrade: the
# host_executable entries below are pinned to this plugin install's own bin/ directory (the
# plugin-bin placeholder, substituted per repo by codex-setup.sh), which changes with the
# installed version.
#
# One prefix_rule or host_executable per line, flat token lists only (no union sub-lists) — see
# docs/reference/codex.md for what each section does and its limits.

# --- allow: the harness's own git/gh usage (ADVISORY Q1, widened set) -------------------------
prefix_rule(pattern = ["git", "add"], decision = "allow", justification = "harness commits its own work")
prefix_rule(pattern = ["git", "commit"], decision = "allow", justification = "harness commits its own work")
prefix_rule(pattern = ["git", "push"], decision = "allow", justification = "harness pushes its own branches")
prefix_rule(pattern = ["git", "fetch"], decision = "allow", justification = "harness reads remote state")
prefix_rule(pattern = ["git", "pull"], decision = "allow", justification = "harness syncs the default branch")
prefix_rule(pattern = ["git", "checkout"], decision = "allow", justification = "harness switches branches")
prefix_rule(pattern = ["git", "switch"], decision = "allow", justification = "harness switches branches")
prefix_rule(pattern = ["git", "restore", "--staged"], decision = "allow", justification = "harness unstages its own work")
prefix_rule(pattern = ["git", "reset", "--soft"], decision = "allow", justification = "harness rewinds its own commits")
prefix_rule(pattern = ["gh"], decision = "allow", justification = "harness reads and writes issues, PRs and labels")

# --- forbidden: ports of templates/repo-settings.json's bare deny entries ----------------------
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "forbidden", justification = "merges stay a human or an explicit grant's decision")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "force-push can discard remote history")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "force-push can discard remote history")
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "forbidden", justification = "force-push can discard remote history")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "can discard uncommitted work")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "can discard untracked work")
prefix_rule(pattern = ["rm", "-rf"], decision = "forbidden", justification = "recursive force delete is a destructive footgun")
prefix_rule(pattern = ["git", "branch", "-D", "main"], decision = "forbidden", justification = "protects the default branch")
prefix_rule(pattern = ["git", "push", "origin", "main"], decision = "forbidden", justification = "protects the default branch")

# --- gated: harness scripts that call gh or write .git, host_executable-pinned -----------------
# Each pair below allows the script's bare name AND pins the match to this plugin install's own
# bin/ directory (the plugin-bin placeholder), so a same-named file a subagent writes into the
# workspace can never qualify (#408, ADR 0002 amendment 2026-09-26(2) Q1).
prefix_rule(pattern = ["check-decision-record.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "check-decision-record.sh", paths = ["@PLUGIN_BIN@/check-decision-record.sh"])
prefix_rule(pattern = ["check-harness.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "check-harness.sh", paths = ["@PLUGIN_BIN@/check-harness.sh"])
prefix_rule(pattern = ["cleanup-after-merge.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "cleanup-after-merge.sh", paths = ["@PLUGIN_BIN@/cleanup-after-merge.sh"])
prefix_rule(pattern = ["find-implementation-work.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "find-implementation-work.sh", paths = ["@PLUGIN_BIN@/find-implementation-work.sh"])
prefix_rule(pattern = ["find-planning-work.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "find-planning-work.sh", paths = ["@PLUGIN_BIN@/find-planning-work.sh"])
prefix_rule(pattern = ["harness-lock.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "harness-lock.sh", paths = ["@PLUGIN_BIN@/harness-lock.sh"])
prefix_rule(pattern = ["harness-status.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "harness-status.sh", paths = ["@PLUGIN_BIN@/harness-status.sh"])
prefix_rule(pattern = ["harness-stop.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "harness-stop.sh", paths = ["@PLUGIN_BIN@/harness-stop.sh"])
prefix_rule(pattern = ["reconcile-ledger.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "reconcile-ledger.sh", paths = ["@PLUGIN_BIN@/reconcile-ledger.sh"])
prefix_rule(pattern = ["setup-labels.sh"], decision = "allow", justification = "harness script gated by host_executable below")
host_executable(name = "setup-labels.sh", paths = ["@PLUGIN_BIN@/setup-labels.sh"])
