{
  "extraKnownMarketplaces": {
    "trail-blazer-flow": {
      "source": {
        "source": "github",
        "repo": "msummer/trail-blazer-flow"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "trail-blazer-flow@trail-blazer-flow": true
  },
  "permissions": {
    "allow": [
      "Bash(find-planning-work.sh:*)",
      "Bash(setup-labels.sh:*)",
      "Bash(find-implementation-work.sh:*)",
      "Bash(cleanup-after-merge.sh:*)",
      "Bash(check-harness.sh:*)",
      "Bash(harness-status.sh:*)",
      "Bash(reconcile-ledger.sh:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh label list:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(git merge-base:*)",
      "Bash(git reset --soft:*)",
      "Bash(git -C * status *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * restore *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * merge-base *)",
      "Bash(git -C * reset --soft *)",
      "Bash(sleep:*)",
      "Bash(date:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pytest:*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(git branch -D main:*)",
      "Bash(git push origin main:*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push --force-with-lease*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean*)",
      "Bash(git -C * branch -D main*)",
      "Bash(git -C * push origin main*)"
    ]
  }
}
