          "to": "    if $has_merge_policy && $jq_ready; then"
        }
      ],
      "expect_fail": [
        "autonomy-mode-protection"
      ]
    },
    {
      "name": "311-mode-value",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "    [ \"$autonomy_mode_val\" = \"autonomous\" ] && autonomy_on=true",
          "to": "    [ -n \"$autonomy_mode_val\" ] && autonomy_on=true"
        }
      ],
      "expect_fail": [
        "autonomy-mode-inert",
        "autonomy-mode-unfenced"
      ]
    },
    {
      "name": "311-budget-bounds",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "        0|1|2|3) kickback_budget=\"$autonomy_budget_val\" ;;",
          "to": "        0|1|2|3|9) kickback_budget=\"$autonomy_budget_val\" ;;"
        }
      ],
      "expect_fail": [
        "autonomy-mode-budget-out-of-range"
      ]
    },
    {
      "name": "311-defaultmode-sanitize",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "      case \"$file_default_mode\" in\n        *[!A-Za-z]*) dm_display=\"(unrecognised value)\" ;;\n        *) dm_display=\"$file_default_mode\" ;;\n      esac",
          "to": "      dm_display=\"$file_default_mode\""
        }
      ],
      "expect_fail": [
        "autonomy-mode-default-mode"
      ]
    },
    {
      "name": "311-defaultmode-gate",
      "target": "bin/check-harness.sh",
