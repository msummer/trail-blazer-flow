{
  "mutants": [
    {
      "name": "311-merge-gate",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "    if $merge_effective && $merge_denied; then",
          "to": "    if $has_merge_policy && $merge_denied; then"
        },
        {
          "from": "    elif $merge_effective && ! $merge_denied && $merge_allowed; then",
          "to": "    elif $has_merge_policy && ! $merge_denied && $merge_allowed; then"
        }
      ],
      "expect_fail": [
        "autonomy-mode-deny-in-place",
        "autonomy-mode-active"
      ]
    },
    {
      "name": "311-ci-gate",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "  if $merge_effective; then\n    ci_uses_total=0",
          "to": "  if $has_merge_policy; then\n    ci_uses_total=0"
        }
      ],
      "expect_fail": [
        "autonomy-mode-deny-in-place"
      ]
    },
    {
      "name": "311-protection-gate",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "    if $merge_effective && $jq_ready; then",
          "to": "    if $has_merge_policy && $jq_ready; then"
        }
      ],
      "expect_fail": [
        "autonomy-mode-protection"
      ]
    },
    {
      "name": "311-mode-value",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "    [ \"$autonomy_mode_val\" = \"autonomous\" ] && autonomy_on=true",
          "to": "    [ -n \"$autonomy_mode_val\" ] && autonomy_on=true"
        }
      ],
      "expect_fail": [
        "autonomy-mode-inert",
        "autonomy-mode-unfenced"
      ]
    },
    {
      "name": "311-budget-bounds",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "        0|1|2|3) kickback_budget=\"$autonomy_budget_val\" ;;",
          "to": "        0|1|2|3|9) kickback_budget=\"$autonomy_budget_val\" ;;"
        }
      ],
      "expect_fail": [
        "autonomy-mode-budget-out-of-range"
      ]
    },
    {
      "name": "311-defaultmode-sanitize",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "      case \"$file_default_mode\" in\n        *[!A-Za-z]*) dm_display=\"(unrecognised value)\" ;;\n        *) dm_display=\"$file_default_mode\" ;;\n      esac",
          "to": "      dm_display=\"$file_default_mode\""
        }
      ],
      "expect_fail": [
        "autonomy-mode-default-mode"
      ]
    },
    {
      "name": "311-defaultmode-gate",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "    ok \"autonomy mode: autonomous (kickback budget $kickback_budget) — an absent 'Plan auto-approval policy' / 'Merge autonomy policy' section is read as present (merge: harness PRs only); declared sections still apply in full\"\n    if $jq_ready && [ -n \"$read_list\" ]; then\n      ok \"permissions.defaultMode: $default_mode_report (informational)\"\n    fi\n  fi",
          "to": "    ok \"autonomy mode: autonomous (kickback budget $kickback_budget) — an absent 'Plan auto-approval policy' / 'Merge autonomy policy' section is read as present (merge: harness PRs only); declared sections still apply in full\"\n  fi\n  if $jq_ready && [ -n \"$read_list\" ]; then\n    ok \"permissions.defaultMode: $default_mode_report (informational)\"\n  fi"
        }
      ],
      "expect_fail": [
        "autonomy-mode-off",
        "autonomy-mode-inert"
      ]
    },
    {
      "name": "311-first-fence",
      "target": "bin/check-harness.sh",
      "suite": "dev/doctor-tests.sh",
      "filter": "autonomy-mode-",
      "edits": [
        {
          "from": "      /^```/ { if (infence) { exit } else { infence=1; next } }\n      infence { print }\n    ')\"\n    autonomy_mode_val",
          "to": "      { print }\n    ')\"\n    autonomy_mode_val"
        }
      ],
      "expect_fail": [
        "autonomy-mode-unfenced"
      ]
    }
  ]
}
