{
  "mutants": [
    {
      "name": "376-reopened-gate",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "reopened",
      "edits": [
        {
          "from": "          elif [[ \"$state_reason\" == \"REOPENED\" ]]; then\n            # #376 — this issue was reopened after it was closed, so it must never be closed\n            # again. Checked before the comment-marker lookup below, so that lookup and its #249\n            # fail-closed hold are skipped entirely for a reopened issue. Deliberately does not\n            # set keep_reason: the reopened decision arm below has its own wording, never the\n            # multi-PR KEEP arm's.\n            reopened=true\n",
          "to": ""
        }
      ],
      "expect_fail": [
        "reopened-not-reclosed",
        "reopened-no-fix",
        "reopened-write-failure-comment",
        "reopened-short-circuits-view-failure",
        "reopened-trusted-marker-never-read",
        "reopened-then-ordinary-still-closes"
      ]
    },
    {
      "name": "376-reopened-field",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "reopened",
      "edits": [
        {
          "from": ",stateReason --limit 100",
          "to": " --limit 100"
        }
      ],
      "expect_fail": [
        "reopened-not-reclosed",
        "reopened-no-fix",
        "reopened-write-failure-comment",
        "reopened-short-circuits-view-failure",
        "reopened-trusted-marker-never-read",
        "reopened-then-ordinary-still-closes"
      ]
    },
    {
      "name": "376-reopened-lookup-order",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "reopened",
      "edits": [
        {
          "from": "            reopened=true\n          else\n",
          "to": "            reopened=true\n          fi\n          if [[ -z \"$keep_reason\" ]]; then\n"
        }
      ],
      "expect_fail": [
        "reopened-trusted-marker-never-read"
      ]
    },
    {
      "name": "376-reopened-reset",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "reopened",
      "edits": [
        {
          "from": "          reopened=false\n",
          "to": ""
        },
        {
          "from": "    while IFS= read -r issue; do\n",
          "to": "    reopened=false\n    while IFS= read -r issue; do\n"
        }
      ],
      "expect_fail": [
        "reopened-then-ordinary-still-closes"
      ]
    },
    {
      "name": "371-same-line-bare-edit",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "write-failure-close",
      "edits": [
        {
          "from": "gh issue close \"$n\" \\\n               && try_write \"$n\" \"$title\" \"removing the pr-open label\" gh issue edit \"$n\" --remove-label pr-open; then",
          "to": "gh issue close \"$n\" && gh issue edit \"$n\" --remove-label pr-open >/dev/null; then"
        }
      ],
      "expect_fail": [
        "write-failure-close-edit"
      ]
    },
    {
      "name": "371-continuation-bare-close",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "write-failure-close",
      "edits": [
        {
          "from": "try_write \"$n\" \"$title\" \"closing the issue\" gh issue close \"$n\"",
          "to": "gh issue close \"$n\" >/dev/null"
        }
      ],
      "expect_fail": [
        "write-failure-close-close"
      ]
    },
    {
      "name": "371-reopened-bare-edit",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "reopened-write-failure",
      "edits": [
        {
          "from": "                 && try_write \"$n\" \"$title\" \"removing the pr-open label\" gh issue edit \"$n\" --remove-label pr-open; then\n                echo \"        pr-open removed — reopened issue left open\"",
          "to": "                 && gh issue edit \"$n\" --remove-label pr-open >/dev/null; then\n                echo \"        pr-open removed — reopened issue left open\""
        }
      ],
      "expect_fail": [
        "reopened-write-failure-edit"
      ]
    },
    {
      "name": "371-followup-noplan-bare-comment",
      "target": "bin/cleanup-after-merge.sh",
      "suite": "dev/cleanup-tests.sh",
      "filter": "write-failure-followup",
      "edits": [
        {
          "from": "              if try_write \"$n\" \"$title\" \"posting the orphan notice\" gh issue comment \"$n\" --body \"${AUDIT_MARKER}",
          "to": "              if gh issue comment \"$n\" --body \"${AUDIT_MARKER}"
        }
      ],
      "expect_fail": [
        "write-failure-followup-noplan-comment"
      ]
    }
  ]
}
