{
  "mutants": [
    {
      "name": "408-lock-flag-ignored",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "owner-",
      "edits": [
        {
          "from": "if $owner_flag_set; then",
          "to": "if false; then"
        }
      ],
      "expect_fail": [
        "owner-daemon-refused",
        "owner-pid-flag",
        "owner-pid-flag-beats-env",
        "owner-pid-nondigits"
      ]
    },
    {
      "name": "408-lock-env-ignored",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "owner-",
      "edits": [
        {
          "from": "elif [ -n \"${TBF_OWNER_PID:-}\" ]; then",
          "to": "elif false; then"
        }
      ],
      "expect_fail": [
        "owner-pid-env",
        "owner-pid-env-nondigits"
      ]
    },
    {
      "name": "408-lock-owner-digits",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "owner-",
      "edits": [
        {
          "from": "    case \"$owner_flag\" in\n      ''|*[!0-9]*)",
          "to": "    case \"$owner_flag\" in\n      ZZZNEVERMATCHZZZ)"
        }
      ],
      "expect_fail": [
        "owner-pid-nondigits"
      ]
    },
    {
      "name": "408-lock-daemon-check",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "owner-",
      "edits": [
        {
          "from": "    *app-server*)",
          "to": "    *ZZZNEVERMATCHZZZ*)"
        }
      ],
      "expect_fail": [
        "owner-daemon-refused"
      ]
    },
    {
      "name": "482-lock-reread-skipped",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "reclaim-",
      "edits": [
        {
          "from": "  if [ \"$now_ident\" != \"$obs_ident\" ]; then",
          "to": "  if false; then"
        },
        {
          "from": "  if pid_alive \"$now_pid\"; then",
          "to": "  if false; then"
        }
      ],
      "expect_fail": [
        "reclaim-race-replaced",
        "reclaim-race-serial"
      ]
    },
    {
      "name": "482-lock-ident-unchecked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "reclaim-",
      "edits": [
        {
          "from": "  if [ \"$now_ident\" != \"$obs_ident\" ]; then",
          "to": "  if false; then"
        }
      ],
      "expect_fail": [
        "reclaim-race-replaced"
      ]
    },
    {
      "name": "482-lock-arbiter-bypassed",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "reclaim-",
      "edits": [
        {
          "from": "if ! mkdir \"$reclaimdir\" 2>/dev/null; then",
          "to": "if ! mkdir -p \"$reclaimdir\" 2>/dev/null; then"
        }
      ],
      "expect_fail": [
        "reclaim-marker-dead",
        "reclaim-race-concurrent"
      ]
    },
    {
      "name": "482-lock-marker-leaked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "reclaim-",
      "edits": [
        {
          "from": "rc=$?\n  remove_reclaim\n  exit \"$rc\"",
          "to": "rc=$?\n  exit \"$rc\""
        }
      ],
      "expect_fail": [
        "reclaim-race-concurrent",
        "reclaim-race-replaced",
        "reclaim-race-serial"
      ]
    },
    {
      "name": "482-lock-force-keeps-marker",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "reclaim-",
      "edits": [
        {
          "from": "\n    remove_reclaim\n  fi\n\n  if [ ! -d \"$lockdir\" ]; then",
          "to": "\n  fi\n\n  if [ ! -d \"$lockdir\" ]; then"
        }
      ],
      "expect_fail": [
        "reclaim-marker-dead"
      ]
    },
    {
      "name": "251-journal-acquire-dropped",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "    journal_lock_event acquire \"$(cat \"$lockdir/run-id\")\"\n",
          "to": ""
        }
      ],
      "expect_fail": [
        "journal-acquire-release",
        "journal-best-effort",
        "journal-prune",
        "journal-record-size",
        "journal-release-force",
        "journal-session-id",
        "journal-stage-record",
        "journal-worktree-shared",
        "journal-run-stop-record"
      ]
    },
    {
      "name": "251-journal-value-unchecked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "case \"$v\" in ''|-*|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;; esac",
          "to": "case \"$v\" in '') return 1 ;; esac"
        }
      ],
      "expect_fail": [
        "journal-rejects-unsafe-values"
      ]
    },
    {
      "name": "251-journal-runid-unchecked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "journal_runid_ok() {\n  local id=\"$1\" suffix",
          "to": "journal_runid_ok() {\n  return 0\n  local id=\"$1\" suffix"
        }
      ],
      "expect_fail": [
        "journal-prune",
        "journal-reclaim-links-prior",
        "journal-rejects-unsafe-values",
        "journal-release-force"
      ]
    },
    {
      "name": "251-journal-symlink-followed",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "     || [ -L \"$file\" ] || [ ! -f \"$file\" ]; then",
          "to": "     || [ ! -f \"$file\" ]; then"
        },
        {
          "from": "if [ -L \"$file\" ] || { [ -e \"$file\" ]",
          "to": "if false || { [ -e \"$file\" ]"
        }
      ],
      "expect_fail": [
        "journal-requires-run-file"
      ]
    },
    {
      "name": "251-journal-prune-current",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "    [ \"$old\" = \"$current\" ] && continue\n",
          "to": ""
        }
      ],
      "expect_fail": [
        "journal-prune"
      ]
    },
    {
      "name": "251-journal-session-raw",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "    ''|*[!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-]*) return 0 ;;\n",
          "to": "    '') return 0 ;;\n"
        }
      ],
      "expect_fail": [
        "journal-session-id"
      ]
    },
    {
      "name": "251-journal-fatal",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "journal_append \"$journaldir/$rid.jsonl\" \"$rec\" || true",
          "to": "journal_append \"$journaldir/$rid.jsonl\" \"$rec\" || exit 1"
        }
      ],
      "expect_fail": [
        "journal-best-effort",
        "journal-requires-run-file"
      ]
    },
    {
      "name": "251-journal-reclaim-unlinked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "journal_lock_event acquire \"$(cat \"$lockdir/run-id\")\" \"${obs_ident%:*}\"",
          "to": "journal_lock_event acquire \"$(cat \"$lockdir/run-id\")\""
        }
      ],
      "expect_fail": [
        "journal-reclaim-links-prior"
      ]
    },
    {
      "name": "533-run-reason-unchecked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "*\" $f_reason \"*) ;;",
          "to": "*) ;;"
        }
      ],
      "expect_fail": [
        "journal-run-stop-rejects"
      ]
    },
    {
      "name": "533-run-reason-substring",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "case \" $RUN_STOP_REASONS \" in",
          "to": "case \"$RUN_STOP_REASONS\" in"
        },
        {
          "from": "*\" $f_reason \"*) ;;",
          "to": "*\"$f_reason\"*) ;;"
        }
      ],
      "expect_fail": [
        "journal-run-stop-rejects"
      ]
    },
    {
      "name": "533-run-outcome-unchecked",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": " || [ \"$f_outcome\" != \"stopped\" ]; then",
          "to": "; then"
        }
      ],
      "expect_fail": [
        "journal-run-stop-rejects"
      ]
    },
    {
      "name": "533-run-extra-keys-allowed",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "[ -n \"$f_issue$f_retries$f_deploy$f_harness$f_pr$f_branch\" ] || ",
          "to": ""
        }
      ],
      "expect_fail": [
        "journal-run-stop-rejects"
      ]
    },
    {
      "name": "533-issue-optional-everywhere",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "|| [ -z \"$f_issue\" ] || [ -z \"$f_outcome\" ]; then",
          "to": "|| [ -z \"$f_outcome\" ]; then"
        }
      ],
      "expect_fail": [
        "journal-run-stop-rejects"
      ]
    },
    {
      "name": "533-run-reason-dropped",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "RUN_STOP_REASONS=\"red-baseline dirty-tree",
          "to": "RUN_STOP_REASONS=\"dirty-tree"
        }
      ],
      "expect_fail": [
        "journal-run-stop-record"
      ]
    },
    {
      "name": "533-run-keys-partial",
      "target": "bin/harness-lock.sh",
      "suite": "dev/lock-tests.sh",
      "filter": "journal-",
      "edits": [
        {
          "from": "[ -n \"$f_issue$f_retries$f_deploy$f_harness$f_pr$f_branch\" ]",
          "to": "[ -n \"$f_issue$f_pr\" ]"
        }
      ],
      "expect_fail": [
        "journal-run-stop-rejects"
      ]
    }
  ]
}
