    },
    {
      "name": "340-inplace-gate",
      "target": "hooks/agent-boundary.sh",
      "suite": "dev/hook-tests.sh",
      "filter": "ab-claude-",
      "edits": [
        {
          "from": "      if (inplace) {",
          "to": "      if (1) {"
        }
